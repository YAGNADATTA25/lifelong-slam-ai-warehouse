    <include>
      <uri>model://euro_pallet</uri>
      <name>pallet_room2</name>
      <pose>2.5 3.0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://wooden_case</uri>
      <name>wooden_case_room2</name>
      <pose>1.5 5.2 0 0 0 0</pose>
    </include>

    <!-- Main Warehouse Floor Models 📦 -->
    <include>
      <uri>model://table</uri>
      <name>table_main_floor</name>
      <pose>-2.0 -4.0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://euro_pallet</uri>
      <name>pallet_main_1</name>
      <pose>-10.0 5.0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://dumpster</uri>
      <name>dumpster_warehouse</name>
      <pose>10.0 6.0 0 0 0 0</pose>
