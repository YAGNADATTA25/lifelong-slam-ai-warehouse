        <visual name="v"><geometry><box><size>0.2 5.2 3.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- Right Wall -->
      <link name="r2_right"><pose>5.0 3.5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 5.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5.2 3.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- Front Wall Left Segment -->
      <link name="r2_front_left"><pose>0.1 1.0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.4 0.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.4 0.2 3.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- Front Wall Right Segment -->
      <link name="r2_front_right"><pose>3.9 1.0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.4 0.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.4 0.2 3.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- REAL 3D MESH MODELS                                       -->
    <!-- ========================================================= -->

    <!-- Room 1 Models 🛠️ -->
    <include>
      <uri>model://work_bench</uri>
      <name>workbench_room1</name>
      <pose>-4.5 2.2 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://bookshelf</uri>
      <name>shelving_room1</name>
      <pose>-7.8 5.0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://euro_pallet</uri>
      <name>pallet_room1</name>
      <pose>-7.0 3.0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://cabinet</uri>
      <name>cabinet_room1</name>
      <pose>-5.5 5.5 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://cardboard_box</uri>
      <name>box_room1</name>
      <pose>-4.8 2.8 0 0 0 0</pose>
    </include>

    <!-- Room 2 Models 🛠️ -->
    <include>
      <uri>model://work_bench</uri>
      <name>workbench_room2</name>
      <pose>0.8 2.2 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://bookshelf</uri>
      <name>shelving_room2</name>
