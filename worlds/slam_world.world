<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="slam_world">

    <!-- Physics & World Settings ⚙️ -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.1 0.1 0.1 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun Light Source ☀️ -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Floor Plane 🟩 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ========================================================= -->
    <!-- OVERHEAD DEPTH CAMERA 1 (ROOM 1)                          -->
    <!-- ========================================================= -->
    <model name="room1_overhead_camera">
      <static>true</static>
      <pose>-6.0 3.5 3.0 0 1.5708 1.5708</pose>
      <link name="room1_camera_link">
        <sensor type="depth" name="room1_depth_camera">
          <always_on>true</always_on>
          <update_rate>30.0</update_rate>
          <camera>
            <horizontal_fov>2.0</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
          <plugin name="room1_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/overhead/room1</namespace>
              <remapping>image_raw:=image_raw</remapping>
              <remapping>depth/image_raw:=depth/image_raw</remapping>
              <remapping>points:=points</remapping>
            </ros>
            <camera_name>room1_camera</camera_name>
            <frame_name>room1_camera_link</frame_name>
            <min_depth>0.1</min_depth>
            <max_depth>10.0</max_depth>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- OVERHEAD DEPTH CAMERA 2 (ROOM 2)                          -->
    <!-- ========================================================= -->
    <model name="room2_overhead_camera">
      <static>true</static>
      <pose>2.0 3.5 3.0 0 1.5708 1.5708</pose>
      <link name="room2_camera_link">
        <sensor type="depth" name="room2_depth_camera">
          <always_on>true</always_on>
          <update_rate>30.0</update_rate>
          <camera>
            <horizontal_fov>2.0</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
          <plugin name="room2_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/overhead/room2</namespace>
              <remapping>image_raw:=image_raw</remapping>
              <remapping>depth/image_raw:=depth/image_raw</remapping>
              <remapping>points:=points</remapping>
            </ros>
            <camera_name>room2_camera</camera_name>
            <frame_name>room2_camera_link</frame_name>
            <min_depth>0.1</min_depth>
            <max_depth>10.0</max_depth>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- EXTERNAL WAREHOUSE WALLS (24m x 18m CENTERED AT 0,0)      -->
    <!-- ========================================================= -->
    <model name="warehouse_outer_walls">
      <static>true</static>
      <!-- North Wall -->
      <link name="wall_north">
        <pose>0.0 9.0 2.75 0 0 0</pose>
        <collision name="col"><geometry><box><size>24.3 0.3 5.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>24.3 0.3 5.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- South Wall -->
      <link name="wall_south">
        <pose>0.0 -9.0 2.75 0 0 0</pose>
        <collision name="col"><geometry><box><size>24.3 0.3 5.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>24.3 0.3 5.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- West Wall -->
      <link name="wall_west">
        <pose>-12.0 0.0 2.75 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.3 18.3 5.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 18.3 5.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- East Wall -->
      <link name="wall_east">
        <pose>12.0 0.0 2.75 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.3 18.3 5.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 18.3 5.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- INTERIOR ROOM 1 (6m x 5m CENTERED AT X=-6.0, Y=3.5)        -->
    <!-- ========================================================= -->
    <model name="room1_structure">
      <static>true</static>
      <!-- Roof / Ceiling 🏠 -->
      <link name="r1_roof"><pose>-6.0 3.5 3.05 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.2 5.2 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.2 5.2 0.1</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- Back Wall -->
      <link name="r1_back"><pose>-6.0 6.0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.2 0.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.2 0.2 3.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- Left Wall -->
      <link name="r1_left"><pose>-9.0 3.5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 5.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5.2 3.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- Right Wall -->
      <link name="r1_right"><pose>-3.0 3.5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 5.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5.2 3.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- Front Wall Left Segment -->
      <link name="r1_front_left"><pose>-7.9 1.0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.4 0.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.4 0.2 3.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- Front Wall Right Segment -->
      <link name="r1_front_right"><pose>-4.1 1.0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.4 0.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.4 0.2 3.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- INTERIOR ROOM 2 (6m x 5m CENTERED AT X=2.0, Y=3.5)         -->
    <!-- ========================================================= -->
    <model name="room2_structure">
      <static>true</static>
      <!-- Roof / Ceiling 🏠 -->
      <link name="r2_roof"><pose>2.0 3.5 3.05 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.2 5.2 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.2 5.2 0.1</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <!-- Back Wall -->
      <link name="r2_back"><pose>2.0 6.0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>6.2 0.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.2 0.2 3.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
