    <include>
      <uri>model://construction_cone</uri>
      <name>cone_2</name>
      <pose>-3.5 -5.0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://construction_barrel</uri>
      <name>barrel_1</name>
      <pose>6.0 -3.0 0 0 0 0</pose>
    </include>

  </world>
</sdf>